---
interface Props {
  lang: 'zh' | 'en';
  alternate: string;
  quiet?: boolean;
}

const { lang, alternate, quiet = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
const home = lang === 'zh' ? withBase('/') : withBase('/en/');
---

<header class:list={["site-header", { "site-header--quiet": quiet }]}> 
  <a class="wordmark" href={home} aria-label={lang === 'zh' ? '席间首页' : 'At the Counter home'}>
    <span class="wordmark__han">席间</span>
    <span class="wordmark__en">At the Counter</span>
  </a>

  <nav class="site-nav" aria-label={lang === 'zh' ? '网站导航' : 'Site navigation'}>
    <a href={home}>{lang === 'zh' ? '食记' : 'Notes'}</a>
    <span aria-hidden="true">/</span>
    <a class="language-link" href={withBase(alternate)} lang={lang === 'zh' ? 'en' : 'zh-CN'}>
      {lang === 'zh' ? 'EN' : '中文'}
    </a>
  </nav>
</header>
