---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---

<BaseLayout
  lang="zh"
  title="席间 · At the Counter"
  description="关于料理、城市与席间判断的双语食记。"
  alternate="/en/"
>
  <SiteHeader lang="zh" alternate="/en/" />

  <main id="content">
    <section class="home-hero">
      <div class="home-hero__edition">
        <span>食记 · 一</span>
        <span>Stockholm, 2026</span>
      </div>
      <div class="home-hero__title">
        <p>Notes from the counter</p>
        <h1>一道料理，<br />如何抵达一座城市。</h1>
      </div>
      <div class="counter-line" aria-hidden="true">
        <i></i><i></i><i></i><i></i><i></i>
      </div>
      <p class="home-hero__intro">
        不追逐食材的身价，也不急着替一顿饭定论。只记火候、质地、调味与席间的选择，看繁味退去以后，舌上还留下什么。
      </p>
    </section>

    <section class="notes-index" aria-labelledby="latest-heading">
      <div class="section-heading">
        <p>Latest note</p>
        <h2 id="latest-heading">最近一席</h2>
      </div>

      <a class="note-card" href={withBase('/notes/sushi-sho/')} data-reveal>
        <div class="note-card__plate">
          <img src={withBase('/images/sushi-sho/15-toro-nigiri.jpg')} alt="盘中两贯金枪鱼大腹握寿司" loading="lazy" decoding="async" />
          <span class="note-card__seal" aria-hidden="true">鮨</span>
          <span class="note-card__course">NOTE 001</span>
        </div>
        <div class="note-card__copy">
          <div class="note-card__meta">
            <span>Stockholm</span>
            <span>12 min</span>
          </div>
          <h3>前菜未能说服我，<br />握寿司却让一席渐明</h3>
          <p>一席由繁入简的寿司：北欧食材与江户前手法，终于在克制里相认。</p>
          <span class="text-link">阅读全文 <span aria-hidden="true">↗</span></span>
        </div>
      </a>
    </section>

    <section class="manifesto" data-reveal>
      <p class="manifesto__mark" aria-hidden="true">間</p>
      <blockquote>“让北欧食材说出地方，让江户前手法守住次序，让鱼仍然是鱼。”</blockquote>
      <p>席间笔记不是评分表。它留下犹豫与修正，也留下味道在一餐之中如何转身。</p>
    </section>
  </main>

  <SiteFooter lang="zh" />
</BaseLayout>
